{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["static/jschannel.js"],
      "project": ["static/**/*.js"]
    },
    "sketch_tool": {
      "entry": ["debugConfigs.js", "lib/plugins/{axes,background,image}.js"],
      "project": ["*.js", "lib/**/*.js", "styles/**/*.{scss,sass}"],
      "webpack": {
        "config": [
          "webpack.common.js",
          "webpack.development.js",
          "webpack.production.js"
        ]
      },
      "ignoreDependencies": ["buffer"]
    }
  }
}
